<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VentiloTray.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Width="360" VerticalAlignment="Top" KeyDown="Root_KeyDown">

        <!-- Thèmes de saison : motif du coin haut-droit (dessiné en code dans un repère 230×178, réduit) -->
        <Canvas x:Name="DecorLayer" Width="180" Height="140"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-10,0"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="DecorSway" CenterX="180" CenterY="16" />
            </Canvas.RenderTransform>
            <Canvas x:Name="DecorArt">
                <Canvas.RenderTransform>
                    <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
                </Canvas.RenderTransform>
            </Canvas>
        </Canvas>

        <!-- Thèmes de saison : particules (pétales, feuilles, neige, lucioles) -->
        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" />

        <!-- Page principale -->
        <StackPanel x:Name="MainPage">
            <StackPanel Padding="20" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="92" Height="92">
                        <Canvas Width="100" Height="100">
                            <Ellipse x:Name="Halo" Width="98" Height="98" Canvas.Left="1" Canvas.Top="1" Opacity="0" />
                            <Ellipse x:Name="FanRing" Width="92" Height="92" Canvas.Left="4" Canvas.Top="4" StrokeThickness="1" />
                            <Canvas Width="100" Height="100">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="FanRotate" CenterX="50" CenterY="50" />
                                </Canvas.RenderTransform>
                                <Path x:Name="Blade1" Data="M50,44 C43,34 40,16 50,7 C60,16 57,34 50,44 Z" />
                                <Path x:Name="Blade2" Data="M50,44 C43,34 40,16 50,7 C60,16 57,34 50,44 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="120" CenterX="50" CenterY="50" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Blade3" Data="M50,44 C43,34 40,16 50,7 C60,16 57,34 50,44 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="240" CenterX="50" CenterY="50" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                            <Ellipse x:Name="Hub" Width="20" Height="20" Canvas.Left="40" Canvas.Top="40" StrokeThickness="1" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="FanNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusText" FontSize="13" />
                        <TextBlock x:Name="LastText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="PowerButton" Grid.Column="2" Style="{StaticResource FlatButton}"
                            Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center"
                            Click="Power_Click" AutomationProperties.Name="Marche / arrêt">
                        <FontIcon Glyph="&#xE7E8;" FontSize="18" />
                    </Button>
                </Grid>

                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="SpeedTitle" Text="Vitesse" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="WindText" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid x:Name="SpeedGrid" ColumnSpacing="6" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LightButton" Style="{StaticResource FlatButton}" MinHeight="76" Padding="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="Light_Click">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xEA80;" FontSize="18" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Lumière" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="LightSub" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="ColorButton" Grid.Column="1" Style="{StaticResource FlatButton}" MinHeight="76" Padding="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="Color_Click">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Ellipse x:Name="ColorDot" Width="18" Height="18" StrokeThickness="1" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Couleur" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="ColorSub" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="DirButton" Grid.Column="2" Style="{StaticResource FlatButton}" MinHeight="76" Padding="12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="Dir_Click">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE7AD;" FontSize="18" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform x:Name="DirFlip" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Sens" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="DirSub" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <Border x:Name="Footer" BorderThickness="0,1,0,0" Padding="20,2,8,2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" />
                        <TextBlock x:Name="ConnText" FontSize="12" />
                    </StackPanel>
                    <Button x:Name="SettingsButton" Style="{StaticResource FlatButton}" Width="40" Height="40"
                            BorderThickness="0" HorizontalAlignment="Right" Click="Settings_Click"
                            AutomationProperties.Name="Paramètres">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Paramètres -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="8,8,20,0">
                <Button x:Name="BackButton" Style="{StaticResource FlatButton}" Width="40" Height="40"
                        BorderThickness="0" Click="Back_Click" AutomationProperties.Name="Retour">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="SettingsTitle" Text="Paramètres" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="20,8,20,20" Spacing="16">
                    <RadioButtons x:Name="ThemeChoice" Header="Thème" MaxColumns="2" SelectionChanged="Theme_Changed" />
                    <TextBox x:Name="NameBox" Header="Nom affiché" LostFocus="Name_LostFocus" />
                    <TextBox x:Name="HostBox" Header="Adresse du boîtier" PlaceholderText="ventilo.local ou 192.168.1.50"
                             LostFocus="Host_LostFocus" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Lancer au démarrage de Windows" Toggled="Startup_Toggled" />
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AssumedTitle" Text="État supposé" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="AssumedText" FontSize="12" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="FixOn" Header="Ventilateur" OnContent="Allumé" OffContent="Éteint" Toggled="FixState_Changed" />
                        <ToggleSwitch x:Name="FixLight" Header="Lumière" OnContent="Allumée" OffContent="Éteinte" Toggled="FixState_Changed" />
                        <RadioButtons x:Name="FixColor" Header="Couleur de la lumière" MaxColumns="3" SelectionChanged="FixState_Changed">
                            <x:String>Chaude</x:String>
                            <x:String>Neutre</x:String>
                            <x:String>Froide</x:String>
                        </RadioButtons>
                        <RadioButtons x:Name="FixDir" Header="Sens de rotation" MaxColumns="2" SelectionChanged="FixState_Changed">
                            <x:String>Été</x:String>
                            <x:String>Hiver</x:String>
                        </RadioButtons>
                    </StackPanel>
                    <Button Content="Quitter Ventilo" Click="Quit_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
